# Copy to .env and fill in. NEVER commit real credentials.
# TripStack reads plain environment variables; this file is a template.

# "demo" = local fixtures (default, no credentials needed)
# "live" = query the Amadeus hotel API (requires the keys below)
TRIPSTACK_DATA_MODE=demo

# Amadeus Self-Service API (https://developers.amadeus.com)
# Verify access, coverage and permitted usage before enabling Live Mode.
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
# test.api.amadeus.com (sandbox) or production host
AMADEUS_HOST=test.api.amadeus.com

# Open-weight model served by Ollama (https://ollama.com)
#   ollama pull gemma:7b   <- recommended: 93.3% field accuracy on the benchmark
#   ollama pull gemma:2b   <- ~4x faster, 67.8% accuracy
# See docs/parser-benchmark.md for the measured comparison.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma:7b
# OLLAMA_MODEL=gemma:2b
OLLAMA_TIMEOUT_S=45

# Parser strategy: hybrid (numbers from rules + semantics from the model),
# ai (model output only), rules (no model).
# TRIPSTACK_PARSER_STRATEGY=hybrid
# Set to false to disable the model entirely (rule-based parser only)
TRIPSTACK_USE_AI_PARSER=true

# Misc
TRIPSTACK_HTTP_TIMEOUT_S=20
TRIPSTACK_DEMO_SEED=7
